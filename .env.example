# PitchStudio — Environment Variables
# ============================================
# Copy this file to .env.local for local development.
# For Vercel deployment, add these as Environment Variables in the Vercel dashboard.
#
# How to get each key:
# - Clerk: https://dashboard.clerk.com → Copy API keys
# - Stripe: https://dashboard.stripe.com/test/apikeys → Copy secret + publishable keys
# - Stripe Prices: Create products in Stripe dashboard → Copy price IDs
# - Stripe Webhook: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# - OpenAI: https://platform.openai.com/api-keys → Create API key
# - Turso DB: `turso db create pitchstudio` → Get URL + auth token
# ============================================

# ─── Database (Turso / SQLite) ──────────────────
# Local:  DATABASE_URL=file:./pitchstudio.db
# Turso:  DATABASE_URL=libsql://pitchstudio-xxx.turso.io
DATABASE_URL=file:./pitchstudio.db
DATABASE_AUTH_TOKEN=

# ─── Clerk Authentication ──────────────────────
# Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Stripe Payments ────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create two products in Stripe Dashboard:
# 1. "Starter" — $19/month recurring
# 2. "Pro" — $39/month recurring
# Copy the Price IDs (look like: price_1Qxyz...)
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PRO_PRICE_ID=price_pro_monthly

# ─── OpenAI ──────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...